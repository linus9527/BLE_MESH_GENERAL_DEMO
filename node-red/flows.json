    {
        "id": "function_mqtt_connect",
        "type": "function",
        "z": "flow_gateway_dashboard",
        "name": "MQTT 启用判断",
        "func": "const enabled = String(env.get('MQTT_ENABLED') || 'false').toLowerCase();\nif (!['1', 'true', 'yes', 'on'].includes(enabled)) {\n    return null;\n}\nreturn { action: 'connect' };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 620,
        "wires": [
            [
                "mqtt_gateway_output"
            ]
        ]
    },
    {
        "id": "function_prepare_mqtt",
        "type": "function",
        "z": "flow_gateway_dashboard",
        "name": "生成 MQTT 主题和消息",
        "func": "const enabled = String(env.get('MQTT_ENABLED') || 'false').toLowerCase();\nif (!['1', 'true', 'yes', 'on'].includes(enabled)) {\n    return null;\n}\n\nconst event = msg.payload;\nif (!event || typeof event !== 'object' || typeof event.type !== 'string') {\n    return null;\n}\n\nconst telemetryTypes = new Set(['dht_report', 'ph_report', 'do_report', 'orp_report']);\nconst statusTypes = new Set(['device_online', 'device_offline', 'device_heartbeat', 'sensor_error', 'sensor_recovered']);\nlet channel = 'events';\nif (telemetryTypes.has(event.type)) {\n    channel = 'telemetry';\n} else if (statusTypes.has(event.type)) {\n    channel = 'status';\n}\n\nconst prefix = String(env.get('MQTT_TOPIC_PREFIX') || 'ble_mesh').replace(/^\\/+|\\/+$/g, '');\nconst deviceId = String(event.device_id || 'BLE_MESH_GATEWAY').replace(/[^A-Za-z0-9_-]/g, '_');\nmsg.topic = `${prefix}/${deviceId}/${channel}`;\nmsg.qos = 1;\nmsg.retain = channel === 'status';\nmsg.payload = JSON.stringify({\n    schema_version: 1,\n    received_at: new Date(msg.receivedAt || Date.now()).toISOString(),\n    ...event\n});\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 660,
        "wires": [
            [
                "mqtt_gateway_output"
            ]
        ]
    },
