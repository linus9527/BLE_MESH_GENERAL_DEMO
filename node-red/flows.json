        "head": "",
        "format": "<template>\n  <div class='gateway-card'>\n    <div class='gateway-title'><span class='status-dot' :style=\"{ backgroundColor: msg?.payload?.statusColor || '#78909c' }\"></span><strong>{{ msg?.payload?.statusText || '等待网关串口数据' }}</strong></div>\n    <div class='gateway-grid'>\n      <span>串口：{{ msg?.payload?.serialPort || '未选择' }}</span><span>有效消息：{{ msg?.payload?.validMessages ?? 0 }}</span><span>解析错误：{{ msg?.payload?.parseErrors ?? 0 }}</span><span>最后类型：{{ msg?.payload?.lastType || '暂无' }}</span><span>最后接收：{{ msg?.payload?.lastValidText || '暂无' }}</span><span>网关启动：{{ msg?.payload?.gatewayOnlineText || '暂无' }}</span>\n    </div>\n  </div>\n</template>\n<style>\n.gateway-card{width:100%;padding:6px 8px}.gateway-title{display:flex;align-items:center;gap:8px;font-size:16px}.gateway-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:5px 14px;margin-top:9px;color:#546e7a;font-size:13px}.status-dot{width:12px;height:12px;border-radius:50%;display:inline-block}\n</style>",
