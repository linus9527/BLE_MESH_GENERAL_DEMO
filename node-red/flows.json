    {
        "id": "function_recover_truncated_json",
        "type": "function",
        "z": "flow_gateway_dashboard",
        "name": "恢复截断 DO JSON",
        "func": "const result = global.get('serialParser').parse(msg.payload.raw); if (!result.ok || !result.recovered) { return [null, msg]; } msg.payload = result.event; msg.receivedAt = Date.now(); msg.serialTruncatedRecovered = true; return [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 160,
