    {
        "id": "function_parse_json",
        "type": "function",
        "z": "flow_gateway_dashboard",
        "name": "解析并校验单行 JSON",
        "func": "const raw = Buffer.isBuffer(msg.payload)\n    ? msg.payload.toString('utf8')\n    : String(msg.payload ?? '');\nconst line = raw.trim();\n\nif (!line) {\n    return null;\n}\n\ntry {\n    const event = JSON.parse(line);\n    if (!event || typeof event !== 'object' || Array.isArray(event) || typeof event.type !== 'string') {\n        throw new Error('missing_type');\n    }\n    msg.payload = event;\n    msg.receivedAt = Date.now();\n    return [msg, null];\n} catch (error) {\n    return [null, {\n        payload: {\n            type: 'serial_parse_error',\n            error: error.message,\n            raw: line,\n            received_at: new Date().toISOString()\n        }\n    }];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 100,
        "wires": [
            [
                "function_sensor_state",
                "function_prepare_mqtt",
                "function_gateway_diagnostics"
            ],
            [
                "function_recover_truncated_json"
            ]
        ]
    },
