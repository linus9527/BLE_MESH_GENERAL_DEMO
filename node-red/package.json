{
  "name": "ble-mesh-gateway-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Node-RED dashboard and MQTT bridge for the BLE Mesh gateway",
  "scripts": {
    "start": "node scripts/start.js",
    "start:direct": "node-red --userDir . --settings settings.js flows.json",
    "validate": "node scripts/validate-flow.js",
    "test": "node scripts/validate-flow.js && node scripts/test-functions.js"
  },
  "dependencies": {
    "@flowfuse/node-red-dashboard": "1.30.2",
    "node-red": "5.0.4",
    "node-red-node-serialport": "2.0.3",
    "serialport": "12.0.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@9.15.9"
}
