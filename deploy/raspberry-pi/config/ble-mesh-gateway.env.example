SERIAL_PORT=auto
SERIAL_PROBE_TIMEOUT_MS=3200
PORT=1880
NODE_RED_HOST=0.0.0.0
HISTORY_DATA_DIR_ROOT=/var/lib/ble-mesh-gateway
HISTORY_DATA_DIR=/var/lib/ble-mesh-gateway/data
HISTORY_DB=/var/lib/ble-mesh-gateway/data/sensor-history.sqlite
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=ble-mesh-gateway-pi
MQTT_TOPIC_PREFIX=ble_mesh
NODE_RED_CREDENTIAL_SECRET=replace-during-install
NODE_OPTIONS=--max-old-space-size=256
NODE_VERSION=24.19.0
PNPM_VERSION=9.15.9
ALLOW_ARMV7L=0
INSTALL_BUILD_TOOLS=1
NODE_RUNTIME_ARCHIVE=
NODE_RUNTIME_SHA256=
