#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		app-red = &led0;
		app-green = &led1;
		app-blue = &led2;
	};
};

&pinctrl {
	rs485_uart_default: rs485_uart_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 4)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 5)>;
			bias-pull-up;
		};
	};

	rs485_uart_sleep: rs485_uart_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 4)>,
				<NRF_PSEL(UART_RX, 0, 5)>;
			low-power-enable;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&rs485_uart_default>;
	pinctrl-1 = <&rs485_uart_sleep>;
	pinctrl-names = "default", "sleep";

	modbus0 {
		compatible = "zephyr,modbus-serial";
		status = "okay";
		de-gpios = <&xiao_d 2 GPIO_ACTIVE_HIGH>;
	};
};
