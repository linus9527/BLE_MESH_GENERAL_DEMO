#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	servo_pwm_default: servo_pwm_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 28)>;
		};
	};

	servo_pwm_sleep: servo_pwm_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 28)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	pinctrl-0 = <&servo_pwm_default>;
	pinctrl-1 = <&servo_pwm_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

/ {
	aliases {
		app-red = &led0;
		app-green = &led1;
		app-blue = &led2;
		servo-pwm = &mesh_servo;
	};

	servo_controller {
		compatible = "pwm-leds";
		mesh_servo: servo_0 {
			pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};
};